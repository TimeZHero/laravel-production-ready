              "threats": [
                {
                  "id": "a866e7a0-3f8b-4eed-b769-67292ae1b7b3",
                  "title": "Access to dotfiles or arbitrary PHP files",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Requests for .env, .git or non-front-controller PHP.",
                  "mitigation": "nginx denies dotfiles and only executes index.php; security headers via security-headers.conf.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                },
                {
                  "id": "0388dc38-3daf-48ed-b5e8-2f6f13441df9",
                  "title": "Debug output leaks internals",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Stack traces and env in error pages.",
                  "mitigation": "convox.yml sets APP_DEBUG=false and APP_ENV=production.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "aab2943f-4f65-4354-b73a-3a88373b8eca",
                  "title": "Slow requests exhaust workers",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Long requests hold FPM/Octane workers.",
                  "mitigation": "Nested timeouts: max_execution_time 60, request_terminate_timeout 60s, Convox timeout 60; autoscaling 1-30.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                },
                {
                  "id": "6d0dd4f6-2897-442f-b6b4-1c727d54eb9f",
