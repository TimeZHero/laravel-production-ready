                  "mitigation": "All processes run as non-root UID 1000.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "fb23ba53-e215-475e-9804-3bd1503a13a4",
                  "title": "Concurrent migrations corrupt schema",
                  "status": "Mitigated",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Several replicas migrate at once on deploy.",
                  "mitigation": "migrate --force --isolated=1; unlocked bootstrap only when the migrations table is missing; first deploy with one replica.",
