                {
                  "id": "bd72cd7a-9a89-4164-9bc3-df0de01553a3",
                  "title": "Memory exhaustion kills jobs mid-run",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "A leaking worker reaches memory_limit and fatals inside a job.",
                  "mitigation": "--memory=128 restarts the worker between jobs; PHP_MEMORY_LIMIT=256M gives each job a full 128 MB; scale.memory 320 keeps the pod above the PHP limit so PHP stops a runaway job before an OOMKill; --max-jobs/--max-time recycle.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 9,
                  "score": ""
                },
                {
                  "id": "348fdfeb-93b8-49a5-a4d4-a9dae9569087",
                  "title": "Job runs twice concurrently",
                  "status": "Mitigated",
                  "severity": "Medium",
                  "type": "Tampering",
                  "description": "retry_after shorter than the job timeout.",
                  "mitigation": "--timeout 60 < termination.grace 70 < retry_after 90.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 10,
                  "score": ""
                },
                {
                  "id": "0f0d26ab-0c35-4792-b260-bd8f0a9c7dd5",
                  "title": "Job killed on deploy",
                  "status": "Mitigated",
                  "severity": "Low",
                  "type": "Denial of service",
                  "description": "SIGTERM interrupts a running job.",
                  "mitigation": "Worker finishes the current job within grace 70; long jobs implement Interruptible.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 11,
                  "score": ""
                }
