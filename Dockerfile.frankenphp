# Use Debian (glibc) for better performance - musl libc is slower with PHP ZTS mode
#
# See: https://frankenphp.dev/docs/performance/#dont-use-musl
#
# Not specifying defaults to latest Debian version
#
ARG FRANKENPHP_VERSION=1-php8.5
ARG ENGINE=frankenphp
ARG USER=nobody

# =============================================================================
# Base layer
#
# Installs PHP extensions and the packages required to run the image.
#
# The FrankenPHP php wrapper (scripts/php.frankenphp.sh) is NOT installed
# here so that install-php-extensions can still use the real php binary
# in downstream stages (e.g. development). The wrapper is applied in the
# engine stage instead.
# =============================================================================
FROM dunglas/frankenphp:${FRANKENPHP_VERSION} AS base

ARG USER
# The image's own nobody; compose builds development as sail with the host UID
ARG WWWUSER=65534

ENV USER=${USER}

WORKDIR /app

# Install PHP extensions
#
# - Laravel requirements: https://laravel.com/docs/master/deployment#server-requirements
#
RUN install-php-extensions \
    # Required by Laravel
    ctype \
    curl \
    dom \
    fileinfo \
    gd \
    intl \
    mbstring \
    openssl \
    phar \
    session \
    tokenizer \
    xml \
    pdo \
    pcntl \
    bcmath \
    zip \
    sockets \
    # Standard packages
    simplexml \
    xmlreader \
    xmlwriter \
    iconv \
    redis \
    igbinary \
    # Database drivers
    mysqli \
    pdo_mysql

# - Create user with UID matching host user (for file permission compatibility)
# - Create group and user only if they don't already exist
# - Remove caps
# - Fix permissions
RUN getent passwd ${USER} || { getent group ${USER} || groupadd ${USER}; useradd -u ${WWWUSER} -g ${USER} -m ${USER}; }; \
    setcap -r /usr/local/bin/frankenphp; \
    mkdir -p /home/${USER} && chown ${WWWUSER}:${WWWUSER} /home/${USER}; \
    chown -R ${WWWUSER}:${WWWUSER} /config /data

ENV HOME=/home/${USER}
ENV RUN_MIGRATIONS=true
ENV OCTANE_SERVER=frankenphp
ENV OCTANE_PORT=8080

# Configure PHP
COPY --link confs/php.ini ${PHP_INI_DIR}/conf.d/app.ini
# Entrypoint
COPY --link --chmod=555 scripts/start-container.sh /usr/local/bin/start-container

# Runtime configuration
EXPOSE 8080
HEALTHCHECK --timeout=10s CMD curl --silent --fail http://127.0.0.1:8080/up
ENTRYPOINT ["start-container"]
CMD ["php", "artisan", "octane:start", "--server=frankenphp", "--port=8080"]

# =============================================================================
# Dependencies layer
#
# Local packages should be placed in the packages directory
#
# This layer keeps credentials safe
# =============================================================================
FROM base AS dependencies

ARG COMPOSER_AUTH

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
COPY --link --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY --link composer.* packages .

RUN --mount=type=cache,target=/tmp/composer-cache \
    COMPOSER_CACHE_DIR=/tmp/composer-cache \
    composer install --optimize-autoloader --no-interaction --no-dev --no-scripts --prefer-dist

# =============================================================================
# Build layer
# =============================================================================
FROM dependencies AS build

COPY --from=node:24-trixie-slim /usr/local/ /usr/local/

COPY --link . .

# Octane copies the worker into public/ at start unless it is already there
RUN --mount=type=cache,target=/tmp/npm-cache \
    npm ci --cache /tmp/npm-cache && \
    npm run build && \
    composer dump-autoload --optimize --classmap-authoritative && \
    { [ -f public/frankenphp-worker.php ] || cp vendor/laravel/octane/src/Commands/stubs/frankenphp-worker.php public/; }

# =============================================================================
# FrankenPHP
# =============================================================================
FROM base AS frankenphp

# https://frankenphp.dev/docs/known-issues/#composer-scripts-referencing-php
COPY --link --chmod=555 scripts/php.frankenphp.sh /usr/local/bin/php
ENV PHP_BINARY=/usr/local/bin/php

# =============================================================================
# Production
# =============================================================================
FROM ${ENGINE} AS production

ARG USER
ARG WWWUSER
ARG COMMIT_SHA
ARG GIT_TAG
ARG BRANCH

ENV COMMIT_SHA=${COMMIT_SHA}
ENV GIT_TAG=${GIT_TAG}
ENV BRANCH=${BRANCH}
ENV OCTANE_HTTPS=true

COPY --link --from=dependencies /app/vendor vendor
COPY --link --from=build --exclude=vendor --exclude=node_modules /app .
COPY --link --from=build /app/vendor/composer vendor/composer
COPY --link --from=build /app/vendor/autoload.php vendor/autoload.php

# Code stays root-owned; the app user writes only to storage/ and bootstrap/cache.
# storage:link at build: the root filesystem is read-only at runtime
RUN chown -R ${WWWUSER}:${WWWUSER} storage bootstrap/cache && \
    ln -sfn ../storage/app/public public/storage

# Switch to non-root user for runtime
USER ${WWWUSER}

# =============================================================================
# Development
# =============================================================================
FROM base AS development

ARG USER
ARG WWWUSER

ENV OPCACHE_VALIDATE_TIMESTAMPS=1
ENV OCTANE_HTTPS=false
# Composer restarts PHP without Xdebug through `-n -c`, which the frankenphp wrapper can't pass
ENV COMPOSER_ALLOW_XDEBUG=1

# Install dev-only packages and PHP extensions
# install-php-extensions needs the real php binary (not the FrankenPHP wrapper),
# so this stage inherits from base (where php is still the real binary).
# The wrapper is applied afterwards via COPY.
RUN apt-get update && apt-get install -y --no-install-recommends bash git \
    && install-php-extensions xdebug \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Debian 13 pins Node at 20.19, but @laravel/multiplex (php artisan dev) needs >= 22.13
COPY --from=node:24-trixie-slim /usr/local/ /usr/local/
COPY --link --from=composer:2 /usr/bin/composer /usr/bin/composer

# Enable xdebug
COPY --link confs/xdebug.ini ${PHP_INI_DIR}/conf.d/xdebug-config.ini

# https://frankenphp.dev/docs/known-issues/#composer-scripts-referencing-php
COPY --link --chmod=555 scripts/php.frankenphp.sh /usr/local/bin/php
ENV PHP_BINARY=/usr/local/bin/php

# Docker Desktop shows the bind-mounted /app as root-owned, which git refuses as dubious ownership
RUN git config --system --add safe.directory /app

# Switch to non-root user for runtime
USER ${WWWUSER}

CMD ["php", "artisan", "dev"]

# =============================================================================
# Default target
# =============================================================================
FROM production
